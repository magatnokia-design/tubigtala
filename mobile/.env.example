# Copy to .env (ignored by git). All EXPO_PUBLIC_ values are bundled into the APK and are
# readable by anyone who has it: only public config here, never TextBee/Brevo/service-account keys.

# Local emulators (default). Set to false to use the real Firebase project.
EXPO_PUBLIC_USE_EMULATOR=true
# PC address the phone can reach. Usually auto-detected from Expo; set it if sign-in can't connect.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.10

# Real project (tubigtala-64d9e) web app config, from Firebase console > Project settings > Your apps.
# Not set up yet - needs a registered app first.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tubigtala-64d9e.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=tubigtala-64d9e
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in in the APK (Firebase console > Authentication > Sign-in method > Google >
# Web SDK configuration > Web client ID). Public value. Also needs mobile/google-services.json.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
