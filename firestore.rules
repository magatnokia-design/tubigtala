rules_version = '2';

// Access design: docs/data-model.md ("Access rules"). Tests: devtools/rules.test.mjs.
// Anything not explicitly allowed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isNumberIn(v, lo, hi) {
      return (v is int || v is float) && v >= lo && v <= hi;
    }

    function isNullOrNumberIn(v, lo, hi) {
      return v == null || isNumberIn(v, lo, hi);
    }

    // One profile per account: name, PH mobile number and alert preferences. Personal data,
    // so only its owner can read or write it.
    match /users/{uid} {
      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }

      function validProfile(p) {
        return p.keys().hasOnly(['displayName', 'phoneE164', 'smsAlertsEnabled', 'pushEnabled',
                                 'createdAt', 'updatedAt'])
          && p.keys().hasAll(['displayName', 'phoneE164', 'smsAlertsEnabled', 'pushEnabled',
                              'createdAt', 'updatedAt'])
          && p.displayName is string
          && p.displayName.trim().size() >= 1 && p.displayName.size() <= 60
          && (p.phoneE164 == null || (p.phoneE164 is string && p.phoneE164.matches('^[+]639[0-9]{9}$')))
          && p.smsAlertsEnabled is bool
          && (!p.smsAlertsEnabled || p.phoneE164 != null)
          && p.pushEnabled is bool
          && p.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      // Last status per device and field (domain/alerts.ts), so one ongoing condition raises one
      // alert. Written only by the backend, in the same transaction as the alert. Until app 0.9.4
      // the open app wrote it too; it no longer may, because an app with the default limits built
      // in would record levels that the station's own limits (devices/{id}.limits) do not give.
      match /alertState/{key} {
        allow read: if isOwner();
      }

      // Push addresses (Firebase Cloud Messaging registration tokens) of the owner's phones. The
      // app writes one per phone while phone notifications are on and deletes it on sign-out or
      // switch-off; the backend (firebase-admin, not bound by these rules) reads them to send alert
      // notifications and deletes the ones FCM reports as no longer valid. The document ID is a
      // short hash of the token (domain/push.ts), not the token itself.
      match /pushTokens/{tokenId} {
        function validPushToken(t) {
          return t.keys().hasOnly(['token', 'platform', 'appVersion', 'updatedAt'])
            && t.keys().hasAll(['token', 'platform', 'appVersion', 'updatedAt'])
            && t.token is string && t.token.size() >= 20 && t.token.size() <= 4096
            && t.platform == 'android'
            && t.appVersion is string && t.appVersion.size() <= 20
            && t.updatedAt == request.time;
        }

        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && tokenId.matches('^[a-z0-9]{1,32}$')
          && validPushToken(request.resource.data);
      }

      // Alerts, raised only by the backend (functions/src/readings.ts, stations.ts; firebase-admin
      // is not bound by these rules). Until app 0.9.4 the open app could create them too; no
      // longer, so every alert follows the station's own limits (see alertState above).
      // The owner can mark them read and delete them.
      match /notifications/{notificationId} {
        allow read: if isOwner();
        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow delete: if isOwner();
      }
    }

    match /devices/{deviceId} {
      // The owner reads it in the app; the board reads its own record to pick up its pH
      // calibration (docs/device-setup.md).
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || resource.data.deviceUid == request.auth.uid);

      function differs(a, b, by) {
        return a - b >= by || b - a >= by;
      }

      // Two-point pH calibration saved by the app's calibration screen. "calibrated" needs both
      // buffer voltages (module output, mV), 100-1500 mV apart in either direction - the same rule
      // as the app (domain/calibration.ts) and the firmware (cloud.cpp) - stamped with server time.
      // The buffers' true pH (e.g. 6.86 / 4.01) is optional; missing means 7.00 / 4.00.
      function validBuffer(c, key, lo, hi) {
        return !(key in c) || ((c[key] is int || c[key] is float) && c[key] >= lo && c[key] <= hi);
      }

      function validCalibration(c) {
        return c is map
          && c.keys().hasOnly(['status', 'calibratedAt', 'method', 'ph7Mv', 'ph4Mv', 'ph7BufferPh', 'ph4BufferPh'])
          && (
            (c.status == 'uncalibrated' && c.calibratedAt == null)
            || (c.status == 'calibrated'
                && c.keys().hasAll(['ph7Mv', 'ph4Mv'])
                && (c.ph7Mv is int || c.ph7Mv is float) && c.ph7Mv >= 0 && c.ph7Mv <= 5500
                && (c.ph4Mv is int || c.ph4Mv is float) && c.ph4Mv >= 0 && c.ph4Mv <= 5500
                && differs(c.ph7Mv, c.ph4Mv, 100)
                && c.ph7Mv - c.ph4Mv <= 1500 && c.ph4Mv - c.ph7Mv <= 1500
                && validBuffer(c, 'ph7BufferPh', 6.5, 7.5)
                && validBuffer(c, 'ph4BufferPh', 3.5, 4.5)
                && c.calibratedAt == request.time
                && c.method is string && c.method.size() <= 80)
          );
      }

      // Alert limits per sensor (domain/limits.ts, same checks as validRange there): within what
      // the sensor can report, critical below <= normal from < normal to <= critical above, and
      // ammonia gas on the high side only (its low limits 0). Stamped with server time.
      function validRange(r, lo, hi) {
        return r is map
          && r.keys().hasOnly(['normalMin', 'normalMax', 'criticalBelow', 'criticalAbove'])
          && r.keys().hasAll(['normalMin', 'normalMax', 'criticalBelow', 'criticalAbove'])
          && isNumberIn(r.normalMin, lo, hi) && isNumberIn(r.normalMax, lo, hi)
          && isNumberIn(r.criticalBelow, lo, hi) && isNumberIn(r.criticalAbove, lo, hi)
          && r.criticalBelow <= r.normalMin
          && r.normalMin < r.normalMax
          && r.normalMax <= r.criticalAbove;
      }

      function validLimits(l) {
        return l is map
          && l.keys().hasOnly(['ph', 'temperatureC', 'nh3GasMv', 'updatedAt'])
          && l.keys().hasAll(['ph', 'temperatureC', 'nh3GasMv', 'updatedAt'])
          && validRange(l.ph, 0, 14)
          && validRange(l.temperatureC, -10, 125)
          && validRange(l.nh3GasMv, 0, 5500)
          && l.nh3GasMv.normalMin == 0 && l.nh3GasMv.criticalBelow == 0
          && l.updatedAt == request.time;
      }

      // Devices (TubigTala Stations) are provisioned by an admin with ownerUid null and a pairing
      // code in devicePairing/{deviceId} (docs/device-setup.md). The name is fixed by the admin.

      // The owner may save or reset its pH calibration - nothing else.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phCalibration'])
        && validCalibration(request.resource.data.phCalibration);

      // The owner may set the station's alert limits, or remove them (back to the defaults).
      // They stay with the station when it is removed, like its calibration.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['limits'])
        && (!('limits' in request.resource.data) || validLimits(request.resource.data.limits));

      // Pair: a signed-in user who has the code from the station's QR sticker takes a station that
      // has no owner. The code is checked against devicePairing, which no client can read.
      allow update: if signedIn()
        && resource.data.ownerUid == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'pairCode', 'pairedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.pairedAt == request.time
        && exists(/databases/$(database)/documents/devicePairing/$(deviceId))
        && request.resource.data.pairCode == get(/databases/$(database)/documents/devicePairing/$(deviceId)).data.code;

      // Remove: the owner releases the station; it can be paired again with the same sticker.
      // Its readings stay with the station (a new owner sees them - accepted for the prototype).
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'pairCode', 'pairedAt'])
        && request.resource.data.ownerUid == null
        && request.resource.data.pairedAt == null
        && !('pairCode' in request.resource.data);

      match /readings/{readingId} {
        function device() {
          return get(/databases/$(database)/documents/devices/$(deviceId)).data;
        }

        function validReading(r) {
          return r.keys().hasOnly(['bootId', 'seq', 'serverTime', 'deviceTime', 'ph',
                                   'phCalibrated', 'phMv', 'temperatureC', 'nh3GasMv',
                                   'simulated', 'firmware'])
            && r.keys().hasAll(['bootId', 'seq', 'serverTime', 'deviceTime', 'ph',
                                'phCalibrated', 'phMv', 'temperatureC', 'nh3GasMv',
                                'simulated', 'firmware'])
            && r.bootId is string && r.bootId.size() >= 4 && r.bootId.size() <= 32
            && r.seq is int && r.seq >= 0
            && readingId == r.bootId + '-' + string(r.seq)
            && r.serverTime == request.time
            && (r.deviceTime == null || r.deviceTime is timestamp)
            && isNullOrNumberIn(r.ph, 0, 14)
            && r.phCalibrated is bool
            && isNullOrNumberIn(r.phMv, 0, 5500)
            // up to the DS18B20's 125 °C (firmware 0.3.3 TEMP_MAX_C; was 60, which hid hot water)
            && isNullOrNumberIn(r.temperatureC, -10, 125)
            && isNullOrNumberIn(r.nh3GasMv, 0, 5500)
            && r.simulated is bool
            && r.firmware is string && r.firmware.size() >= 1 && r.firmware.size() <= 32;
        }

        allow read: if signedIn() && device().ownerUid == request.auth.uid;

        // Create only: re-sending the same reading hits the same ID and is rejected,
        // which is the duplicate-upload guard. No updates or deletes from clients.
        // (The hourly packs below are copies of these, written by the backend.)
        allow create: if signedIn()
          && device().deviceUid == request.auth.uid
          && validReading(request.resource.data)
          && request.resource.data.simulated == device().simulated;
      }

      // Hourly packs: every reading of one UTC hour in one document (mobile/src/domain/hours.ts),
      // written by the backend for each new reading (functions/src/hours.ts). The app reads them for
      // long periods (By date up to 31 days, exports): 744 reads a month instead of up to 44,640.
      // Readable like the readings - by the station's owner - and written by no client.
      match /hours/{hourId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
