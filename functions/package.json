{
  "name": "tubigtala-functions",
  "private": true,
  "type": "module",
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "npm run build && node ../devtools/firebase.mjs emulators:exec --only auth,firestore,functions --project demo-tubigtala \"node --test src/readings.e2e.ts\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
